#: apg-xml-sitemap.php:98 includes/formulario.php:14
msgid "Google Video Sitemap Feed Options."
msgstr "Opciones de Google Video Sitemap."

#: apg-xml-sitemap.php:109
msgid "You do not have permission to access this page."
msgstr "No tienes permisos para acceder a esta página."

#. translators: %s: name of the detected SEO plugin.
#: includes/admin/aviso-seo.php:125
#, php-format
msgid "%s is already publishing a video sitemap, so this plugin is probably redundant. Keeping both is harmless, but you only need one."
msgstr "%s ya está publicando un sitemap de vídeos, así que este plugin probablemente sobre. Tener los dos no hace daño, pero sólo necesitas uno."

#: includes/admin/aviso-seo.php:131
msgid "Deactivate this plugin"
msgstr "Desactivar este plugin"

#: includes/admin/aviso-seo.php:132
msgid "Keep it and hide this notice"
msgstr "Mantenerlo y ocultar este aviso"

#. translators: 1: URL of the page, 2: title of the page, 3: name of the website, 4: identifier of the video.
#: includes/admin/clases/xml.php:366
#, php-format
msgid "Please check the page <a href=\"%1$s\">%2$s</a> from your website %3$s and edit the deleted video with id %4$s.<br /><br />email sent by <a href=\"https://artprojectgroup.es/plugins-para-wordpress/apg-google-video-sitemap-feed\">APG Google Video Sitemap Feed</a>."
msgstr "Por favor revisa la página <a href=\"%1$s\">%2$s</a> de tu sitio web %3$s y edita el vídeo borrado con id %4$s.<br /><br />Correo electrónico enviado por <a href=\"https://artprojectgroup.es/plugins-para-wordpress/apg-google-video-sitemap-feed\">APG Google Video Sitemap Feed</a>."

#: includes/admin/clases/xml.php:367
msgid "Video not found!"
msgstr "¡Vídeo no encontrado!"

#. translators: 1: video identifier, 2: video provider, 3: number of times.
#: includes/admin/clases/xml.php:831
#, php-format
msgid "The video %1$s (%2$s) has been processed %3$d times in 24 hours. Something is queueing it again in a loop."
msgstr "El vídeo %1$s (%2$s) se ha procesado %3$d veces en 24 horas. Algo lo está reencolando en bucle."

#. translators: 1: video identifier, 2: number of attempts.
#: includes/admin/clases/xml.php:848
#, php-format
msgid "The video %1$s could not be read after %2$d attempts. It will not be tried again until its page changes."
msgstr "No se ha podido leer el vídeo %1$s tras %2$d intentos. No se volverá a intentar hasta que cambie su página."

